{
  "name": "protocol-v2-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Protocol Restaurant V2 backend — TypeScript + Express + Prisma + Postgres",
  "main": "app/server.ts",
  "prisma": {
    "schema": "database/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
